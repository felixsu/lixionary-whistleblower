{
  "name": "lixionary-whistleblower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @whistle/server dev",
    "dev:web": "pnpm --filter @whistle/web dev",
    "build": "pnpm --filter @whistle/shared build && pnpm --filter @whistle/server build && pnpm --filter @whistle/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @whistle/server db:generate",
    "db:migrate": "pnpm --filter @whistle/server db:migrate",
    "admin:create": "pnpm --filter @whistle/server admin:create"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3"
  }
}
