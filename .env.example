# --- Server ---
PORT=6400
DATABASE_URL=postgres://whistle:whistle@127.0.0.1:6402/whistle
# 32 random bytes, base64. Generate with: openssl rand -base64 32
CONTACT_ENC_KEY=
# Directory for evidence uploads (never served publicly)
UPLOAD_DIR=./data/uploads
# Set to true behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false

# --- MiniMax (OpenAI-compatible API). Leave the key empty to disable the AI assistant. ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
# "disabled" keeps chat replies fast; "adaptive" lets M3 reason first (slower, sometimes better drafts)
MINIMAX_THINKING=disabled

# --- Mail (dev: mailpit, UI at http://127.0.0.1:6403) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=6404
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Whistleblower <no-reply@whistle.local>"
# Base URL of the web app, used for links in admin emails
PUBLIC_WEB_URL=http://localhost:6401

# --- Web ---
# Where Next.js proxies /api/* to
API_ORIGIN=http://127.0.0.1:6400
