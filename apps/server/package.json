{
  "name": "@whistle/server",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && cp -R src/db/migrations dist/db/",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:create": "tsx src/cli/bootstrap.ts",
    "db:provision": "tsx src/cli/provision.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@whistle/shared": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.16",
    "postgres": "^3.4.9",
    "zod": "^4.6.5",
    "@whistle/runtime": "workspace:*",
    "otplib": "^13.4.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
